{
  "name": "ghostpm",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first task ledger for AI coding sessions: captures work from Claude Code, shows it machine-wide, and syncs it to GitHub Issues or Azure DevOps.",
  "main": "dist/mcp-server.js",
  "bin": {
    "ghostpm": "./dist/cli-main.js"
  },
  "files": [
    "dist",
    ".claude-plugin/plugin.json",
    ".mcp.json",
    "hooks",
    "skills",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "stage": "npm run build && node scripts/stage-release.js",
    "verify-release": "npm run build && node scripts/verify-release.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "node dist/cli-main.js serve",
    "init": "node dist/cli-main.js init"
  },
  "keywords": ["mcp", "project-management", "github-issues", "azure-devops", "agentic-coding"],
  "author": "dpkay",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^5.2.3",
    "zod": "^4.4.3"
  }
}
